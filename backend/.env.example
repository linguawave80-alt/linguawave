# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Firebase (Firestore + Google sign-in verification) ──────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key.
# Easiest: paste the whole JSON as ONE line (or base64-encode it):
#   base64 -i serviceAccount.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT=
# …or use these three instead (leave FIREBASE_SERVICE_ACCOUNT empty):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── JWT (REQUIRED in production — the server refuses to start without them) ─
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Cookies ─────────────────────────────────────────────────────────────────
SESSION_SECRET=change_me_to_a_long_random_string

# ─── AI ──────────────────────────────────────────────────────────────────────
# Optional: without it the app uses built-in demo/mock responses.
GROQ_API_KEY=

# ─── Frontend URL (NO trailing path) ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Production example: https://linguawave-frontend.onrender.com

# ─── Email (Brevo transactional API) ─────────────────────────────────────────
# Without BREVO_API_KEY no email is sent; in development the OTP is printed in the server log.
BREVO_API_KEY=
# Must be a sender verified in your Brevo account
EMAIL_FROM=noreply@yourdomain.com

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated frontend origins (production). localhost is allowed automatically in development.
# Used by BOTH the REST API and Socket.IO.
ALLOWED_ORIGINS=

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Meet (video rooms) ──────────────────────────────────────────────────────
# Max participants per room (WebRTC mesh: 3 => 2 peer connections per browser).
MEET_MAX_PEERS=3
# Max simultaneous rooms on this instance, and per-user room creation limit.
MEET_MAX_ROOMS=100
MEET_CREATE_LIMIT=5
MEET_CREATE_WINDOW_S=600
# Optional TURN relay for peers behind strict NATs. STUN is always offered.
# Use any provider you like; leave empty to run STUN-only.
# MEET_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# MEET_TURN_USERNAME=
# MEET_TURN_CREDENTIAL=
